{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/config.schema.json",
  "title": "ESP Base Config",
  "description": "Generated from espbase/main/config.h",
  "type": "object",
  "properties": {
    "sys.timezone": {
      "description": "Set local timezone (see man tzset(3))",
      "type": "string"
    },
    "sys.history": {
      "description": "Load/dump command line history to file",
      "type": "string"
    },
    "sys.prompt": {
      "description": "Console promption string",
      "type": "string",
      "pattern": "^[0-9a-zA-Z >$]+$"
    },
    "sys.dir.data": {
      "description": "Directory to storage font, image files etc.",
      "type": "string"
    },
    "sys.dir.docs": {
      "description": "Directory to generated documentation",
      "type": "string"
    },
    "sys.dir.html": {
      "description": "Directory to static webpage files",
      "type": "string"
    },
    "sys.btn.high": {
      "description": "Button active high",
      "type": "string",
      "pattern": "^[01yn]?$"
    },
    "sys.int.edge": {
      "description": "Select interrupt type",
      "enum": [
        "NEG",
        "POS",
        "ANY",
        "LOW",
        "HIGH"
      ]
    },
    "sys.adc.mult": {
      "description": "ADC multi-sampling to filter noise",
      "type": "number",
      "minimum": 1,
      "maximum": 255
    },
    "sys.usb.mode": {
      "description": "Select USB work mode",
      "enum": [
        "SERIAL_JTAG",
        "CDC_DEVICE",
        "CDC_HOST",
        "MSC_DEVICE",
        "MSC_HOST",
        "HID_DEVICE",
        "HID_HOST"
      ]
    },
    "sys.bt.mode": {
      "description": "Select BT work mode",
      "enum": [
        "BT_HIDD",
        "BLE_HIDD",
        "BLE_HIDH"
      ]
    },
    "sys.bt.scan": {
      "description": "Bluetooth discoverable",
      "type": "string",
      "pattern": "^[01yn]?$"
    },
    "net.eth.host": {
      "description": "Static IP address of Ethernet",
      "type": "string",
      "anyOf": [
        { "format": "ipv4" },
        { "maxLength": 0 }
      ]
    },
    "net.eth.gate": {
      "description": "Gateway IP address of Ethernet",
      "type": "string",
      "anyOf": [
        { "format": "ipv4" },
        { "maxLength": 0 }
      ]
    },
    "net.sta.ssid": {
      "description": "SSID of the AP to connect after startup",
      "type": "string",
      "anyOf": [
        { "format": "hostname" },
        { "maxLength": 0 }
      ]
    },
    "net.sta.pass": {
      "description": "Password of the AP to connect",
      "type": "string",
      "anyOf": [
        { "pattern": "^[0-9a-zA-Z]{8,}$" },
        { "maxLength": 0 }
      ]
    },
    "net.sta.host": {
      "description": "Static IP address of WiFi station",
      "type": "string",
      "anyOf": [
        { "format": "ipv4" },
        { "maxLength": 0 }
      ]
    },
    "net.sta.gate": {
      "description": "Gateway IP address of WiFi station",
      "type": "string",
      "anyOf": [
        { "format": "ipv4" },
        { "maxLength": 0 }
      ]
    },
    "net.ap.ssid": {
      "description": "SSID of the AP to serve (hotspot name)",
      "type": "string",
      "anyOf": [
        { "format": "hostname" },
        { "maxLength": 0 }
      ]
    },
    "net.ap.pass": {
      "description": "Password of the AP to serve",
      "type": "string",
      "anyOf": [
        { "pattern": "^[0-9a-zA-Z]{8,}$" },
        { "maxLength": 0 }
      ]
    },
    "net.ap.host": {
      "description": "Gateway IP address",
      "type": "string",
      "anyOf": [
        { "format": "ipv4" },
        { "maxLength": 0 }
      ]
    },
    "net.ap.chan": {
      "description": "Channel of AP",
      "type": "number",
      "minimum": 1,
      "maximum": 14
    },
    "net.ap.ncon": {
      "description": "Max number of stations of AP",
      "type": "number",
      "minimum": 1,
      "maximum": 253
    },
    "net.ap.napt": {
      "description": "Enable WiFi NAT router (ESP-IDF v5+)",
      "type": "string",
      "pattern": "^[01yn]?$"
    },
    "net.ap.hide": {
      "description": "Hide AP SSID (not shown on scan)",
      "type": "string",
      "pattern": "^[01yn]?$"
    },
    "net.ap.auto": {
      "description": "Auto switch to AP mode if STA connection failed",
      "type": "string",
      "pattern": "^[01yn]?$"
    },
    "net.sc.auto": {
      "description": "Auto start SmartConfig if STA connection failed",
      "type": "string",
      "pattern": "^[01yn]?$"
    },
    "net.sc.type": {
      "description": "SmartConfig type (ESPTOUCH v1/v2 and/or AIRKISS)",
      "type": "string",
      "enum": [
        "ESPTOUCH V1",
        "ESPTOUCH V2",
        "AIRKISS",
        "ESPTOUCH_AIRKISS"
      ]
    },
    "net.dpp.auto": {
      "description": "Auto DPP(Easy Connect) if STA connection failed",
      "type": "string",
      "pattern": "^[01yn]?$"
    },
    "net.dpp.chan": {
      "description": "DPP channel list separated by comma (1~14)",
      "type": "string",
      "pattern": "^[0-9]+(,[0-9]+){,4}$"
    },
    "net.now.lmk": {
      "description": "ESPNow secret seed used to generate LMK",
      "type": "string",
      "anyOf": [
        { "pattern": "^[0-9a-zA-Z]{16}$" },
        { "maxLength": 0 }
      ]
    },
    "web.ws.name": {
      "description": "Username to auth websocket",
      "type": "string"
    },
    "web.ws.pass": {
      "description": "Password to auth websocket",
      "type": "string",
      "anyOf": [
        { "pattern": "^[0-9a-zA-Z]{8,}$" },
        { "maxLength": 0 }
      ]
    },
    "web.http.name": {
      "description": "Username to auth webserver",
      "type": "string"
    },
    "web.http.pass": {
      "description": "Password to auth webserver",
      "type": "string",
      "anyOf": [
        { "pattern": "^[0-9a-zA-Z]{8,}$" },
        { "maxLength": 0 }
      ]
    },
    "web.auth.base": {
      "description": "Whether to use basic/digest authorization",
      "type": "string",
      "pattern": "^[01yn]?$"
    },
    "web.srv.https": {
      "description": "Whether to use HTTP or HTTPS server",
      "type": "string",
      "pattern": "^[01yn]?$"
    },
    "web.srv.async": {
      "description": "Whether to use async server handler",
      "type": "string",
      "pattern": "^[01yn]?$"
    },
    "app.ota.auto": {
      "description": "Enable auto updation checking",
      "type": "string",
      "pattern": "^[01yn]?$"
    },
    "app.ota.url": {
      "description": "URL to fetch firmware from",
      "type": "string",
      "anyOf": [
        { "format": "uri-reference" },
        { "maxLength": 0 }
      ]
    },
    "app.hbt.run": {
      "description": "Enable heartbeat task",
      "type": "string",
      "pattern": "^[01yn]?$"
    },
    "app.hbt.url": {
      "description": "URL to post heartbeat info",
      "type": "string",
      "anyOf": [
        { "format": "uri-reference" },
        { "maxLength": 0 }
      ]
    },
    "app.hid.mode": {
      "description": "Select gamepad layout",
      "enum": [
        "GENERAL",
        "XINPUT",
        "SWITCH",
        "DSENSE"
      ]
    },
    "app.hid.host": {
      "description": "UDP target hostname or IP address",
      "type": "string",
      "anyOf": [
        { "format": "hostname" },
        { "maxLength": 0 }
      ]
    },
    "app.mqtt.run": {
      "description": "Enable MQTT client",
      "type": "string",
      "pattern": "^[01yn]?$"
    },
    "app.mqtt.url": {
      "description": "MQTT server `scheme://[user:pswd@]host[:port][/path][#cid]`",
      "type": "string"
    },
    "app.mdns.run": {
      "description": "Enable mDNS server",
      "type": "string",
      "pattern": "^[01yn]?$"
    },
    "app.mdns.host": {
      "description": "Register mDNS hostname",
      "type": "string",
      "anyOf": [
        { "format": "hostname" },
        { "maxLength": 0 }
      ]
    },
    "app.sntp.run": {
      "description": "Enable SNTP client",
      "type": "string",
      "pattern": "^[01yn]?$"
    },
    "app.sntp.host": {
      "description": "NTP server to sync time from",
      "type": "string",
      "anyOf": [
        { "format": "hostname" },
        { "maxLength": 0 }
      ]
    },
    "app.tscn.mode": {
      "description": "Select touchscreen mode",
      "enum": [
        "REL",
        "ABS",
        "TCH"
      ]
    }
  }
}
